# Server
HOST=127.0.0.1
PORT=3000

# Internal API
INTERNAL_API_HOST=127.0.0.1
INTERNAL_API_PORT=3001

# Database
DATABASE_URL=postgres://user:password@localhost:5432/chiroo
# 32 random bytes, e.g.: openssl rand 32 | xxd -p -c 32
DATABASE_ENCRYPTION_KEY=

# OpenAI-compatible API
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Embeddings (fall back to OPENAI_BASE_URL / OPENAI_API_KEY when unset)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Reranking (falls back to OPENAI_BASE_URL / OPENAI_API_KEY when unset)
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# Vector store (Qdrant)
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=chiroo
QDRANT_TIMEOUT_SECS=30

# Chunking & search
CHUNK_SIZE=512
SEARCH_LIMIT=10
SEARCH_SCORE_THRESHOLD=0.5
SEARCH_CANDIDATE_LIMIT=30

# App & OIDC
APP_BASE_URL=http://localhost:5143
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# HMAC key for state/CSRF tokens (min 32 chars)
STATE_SECRET=
SESSION_CLEANUP_INTERVAL_SECS=600
SESSION_TTL_MULTIPLIER=10
OIDC_ACCESS_TOKEN_EXPIRES_SECS=300
