# Chiroo server configuration via environment variables.
#
# Precedence (low -> high): built-in defaults (server/config/default.yaml)
#   < -c config file < these variables.
#
# Only values that have NO built-in default are listed below, plus the Qdrant
# URL, which is commonly overridden. For every other setting (server host/port,
# chunking, search, oidc timings, branding, ...) see
# server/config/default.yaml. Naming: CHIROO_<SECTION>__<FIELD>.
#
# Duration-valued settings (e.g. CHIROO_QDRANT__TIMEOUT, CHIROO_OIDC__CLEANUP_INTERVAL)
# use serde's duration format: a string with a unit, e.g. 30s, 5m, 2h.

# Database (required)
CHIROO_DB__URL=postgres://user:password@localhost:5432/chiroo
# 32-char string, e.g.: openssl rand -hex 16
CHIROO_DB__ENCRYPTION_KEY=

# OpenAI-compatible API (required)
CHIROO_OPENAI__BASE_URL=
CHIROO_OPENAI__API_KEY=
CHIROO_OPENAI__MODEL=

# Embeddings (required)
CHIROO_EMBEDDING__BASE_URL=
CHIROO_EMBEDDING__API_KEY=
CHIROO_EMBEDDING__MODEL=
CHIROO_EMBEDDING__DIMENSIONS=

# Reranking (required)
CHIROO_RERANK__BASE_URL=
CHIROO_RERANK__API_KEY=
CHIROO_RERANK__MODEL=

# App & OIDC (required)
CHIROO_OIDC__APP_BASE_URL=http://localhost:5173
CHIROO_OIDC__ISSUER_URL=
CHIROO_OIDC__CLIENT_ID=
CHIROO_OIDC__CLIENT_SECRET=
# HMAC key for state/CSRF tokens (min 32 chars)
CHIROO_OIDC__STATE_SECRET=

# Qdrant (has a built-in default http://localhost:6334; set explicitly when
# overriding, e.g. to point at a remote or non-default host)
CHIROO_QDRANT__URL=http://localhost:6334
